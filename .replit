modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 23275
externalPort = 3000

[userenv]

[userenv.shared]
VITE_FEE_COLLECTOR_ADDRESS = "0xdb5019b8dfbccef8906c39b16a4870082eabbc4c"
VITE_FEE_BPS = "30"
VITE_APP_NAME = "BasePay"
VITE_ROUTER_ADDRESS = "0x756f516cdf5eb98e140eba44119b22fc0f0bb63f"
FEE_COLLECTOR_ADDRESS = "0xdb5019b8dfbccef8906c39b16a4870082eabbc4c"
FEE_BPS = "30"
DEPLOYER_ADDRESS = "0xdb5019b8dfbccef8906c39b16a4870082eabbc4c"
VITE_BATCH_PAY_ADDRESS = "0xe40d2292c050566d16cecda74627b70778806c68"
VITE_ESCROW_ADDRESS = "0x1eb2b1e8dda64fc4ccb0537574f2a2ca9f307499"
VITE_SUBSCRIPTION_MANAGER_ADDRESS = "0x101918a252b3852ac4b50b7bbf2525d3084d5421"

[nix]
