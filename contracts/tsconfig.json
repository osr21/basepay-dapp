{
  "compilerOptions": {
    "target":              "ES2020",
    "module":              "ES2020",
    "moduleResolution":    "bundler",
    "lib":                 ["ES2020", "DOM"],
    "strict":              true,
    "declaration":         true,
    "declarationMap":      true,
    "outDir":              "./dist",
    "resolveJsonModule":   true,
    "esModuleInterop":     true,
    "skipLibCheck":        true
  },
  "include": ["index.ts", "integration/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
